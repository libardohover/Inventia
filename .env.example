# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Si se deja vacía, el agente INVENTIA responde con el motor analítico local.
GEMINI_API_KEY=

# Modelo de Gemini preferido (opcional). Si falla, se prueban modelos de respaldo.
GEMINI_MODEL=gemini-3.8-flash

# Servidor
PORT=3000
HOST=0.0.0.0

# Carpeta donde se guardan los cambios de stock y configuración (opcional)
DATA_DIR=data
# Pon PERSISTENCIA=false para no guardar cambios en disco
PERSISTENCIA=true
